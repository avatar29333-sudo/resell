# انسخ الملف ده لـ .env واملا القيم. ملف .env ما بيترفعش على GitHub.

# قاعدة البيانات. على جهازك: نفس الرابط في الاتنين.
# على Vercel: تكامل Neon بيحطهم لوحده (الأول عبر pooler، والتاني مباشر للـ migrations).
DATABASE_URL="postgresql://resell:resell@localhost:5432/resell"
DATABASE_URL_UNPOOLED="postgresql://resell:resell@localhost:5432/resell"

# مفتاح توقيع الجلسات — نص عشوائي طويل (32 حرف أو أكتر)، مختلف في كل بيئة
SESSION_SECRET="غيّرها-لقيمة-عشوائية-طويلة"

# لما دول يتملوا الرمز بيتبعت فعلاً. فاضيين = وضع تجريبي (الرمز على الشاشة + دخول سريع بحسابات التجربة)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EMAIL_API_KEY=""

# خزنة المستندات (S3 أو متوافق زي Cloudflare R2). فاضية = الملفات في قاعدة البيانات.
# لما تتملي: الملفات الجديدة بتروح S3، والقديمة بتفضل تتقري من قاعدة البيانات.
S3_ENDPOINT=""
S3_BUCKET="resell-docs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# S3_SSE="AES256"          # تشفير من ناحية المزوّد (AWS). R2 بيشفّر لوحده — سيبه فاضي
# S3_FORCE_PATH_STYLE="1"  # لـ MinIO وبعض المزوّدين

# مهمة كل يوم (سعر الصرف + التنبيهات): Vercel بيبعت السر ده في الهيدر
CRON_SECRET=""

# التحقق الثنائي إجباري للفريق — بيتفعّل مع قفل «الدخول السريع» في آخر خطوة
REQUIRE_STAFF_2FA=""

# مراقبة الأخطاء (Sentry). فاضيين = مقفولة
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
