# انسخ الملف ده لـ .env واملا القيم. ملف .env ما بيترفعش على GitHub.

# قاعدة البيانات. على جهازك: نفس الرابط في الاتنين.
# على Vercel: تكامل Neon بيحطهم لوحده (الأول عبر pooler، والتاني مباشر للـ migrations).
DATABASE_URL="postgresql://resell:resell@localhost:5432/resell"
DATABASE_URL_UNPOOLED="postgresql://resell:resell@localhost:5432/resell"

# مفتاح توقيع الجلسات — نص عشوائي طويل (32 حرف أو أكتر)، مختلف في كل بيئة
SESSION_SECRET="غيّرها-لقيمة-عشوائية-طويلة"

# لما دول يتملوا الرمز بيتبعت فعلاً. فاضيين = وضع تجريبي (الرمز على الشاشة + دخول سريع بحسابات التجربة)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
EMAIL_API_KEY=""

# خزنة المستندات. فاضية = الملفات بتتخزن في قاعدة البيانات (للتجربة بس)
S3_ENDPOINT=""
S3_BUCKET="resell-docs"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
