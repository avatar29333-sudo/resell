// Resell — نموذج البيانات (الخطوة 2)
// المرجع: دوك «Resell — خطة البرمجة وطريقة العمل» → قسم «نموذج البيانات».
// الفكرة الأساسية: القطعة (Plot) حاجة ثابتة بكودها، والعروض والصفقات بتتربط بيها.
//
// الفلوس كلها Decimal (مش Float) عشان الحسابات تطلع مظبوطة.
// الحذف: المستندات وسجل التدقيق ما بيتمسحوش (الحماية في src/lib/db.ts و prisma/sql/extras.sql).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // اتصال مباشر من غير pooler — للـ migrations (Neon على Vercel بيظبطه لوحده)
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [postgis]
}

// ───────────────────────── قيم ثابتة ─────────────────────────

enum Role {
  CLIENT // عميل (بائع أو مشتري)
  BROKER // وسيط
  LAWYER // محامي
  AGENT // مندوب الجهاز
  FINANCE // مالي
  ADMIN // أدمن
  PARTNER_BROKER // سمسار شريك من برّه (PERM-05)
  BROKER_LEAD // مسؤول الوسطاء (PERM-05)
}

/// حالة الحساب (PERM-07)
enum AccountStatus {
  ACTIVE
  SUSPENDED
}

/// طلب صرف محتاج موافقة أدمن — قاعدة الأربع عيون (PERM-09)
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// مستويات الحساب — افتراض مبدئي لحد ما نطابقها مع شاشة «مستويات الحساب»
enum AccountLevel {
  BASIC // اتسجل برمز واتساب
  VERIFIED // الهوية اتراجعت واتقبلت
}

enum Locale {
  ar
  en
}

enum Currency {
  EGP
  USD
}

/// نفس المدن اللي في src/i18n/messages

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IdType {
  NATIONAL_ID
  PASSPORT
}

enum PlotPaymentStatus {
  INSTALLMENTS // لسه بيقسّط
  FULLY_PAID // سداد كامل الثمن
}

enum PriceType {
  ALL_INCLUSIVE // شامل
  PAID_PLUS_PREMIUM // المدفوع بالدولار + أوفر
}

enum ListingStatus {
  DRAFT // مسودة
  IN_REVIEW // مراجعة
  VERIFIED // موثّق
  PUBLISHED // منشور
  IN_DEAL // في صفقة
  SOLD // مباع
  WITHDRAWN // البائع سحبه (مش في الدوك — مضافة عشان ما نمسحش عروض)
}

enum DocumentType {
  NATIONAL_ID // بطاقة
  PASSPORT // باسبور
  SELFIE // صورة شخصية للتوثيق
  ALLOCATION_LETTER // خطاب التخصيص
  PAYMENT_RECEIPT // إيصالات السداد
  AUTHORITY_STATEMENT // إفادة الجهاز
  SITE_PHOTO // صور المعاينة
  TRANSFER_RECEIPT // إيصال تحويل العربون
  CONTRACT_PDF // نسخة عقد
  POWER_OF_ATTORNEY // توكيل
  OTHER
  FILING_RECEIPT // إيصال تقديم الطلب في الجهاز (المندوب)
}

enum DocumentStatus {
  UPLOADED
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED // اتعمل له إصدار أحدث
}

enum ReviewDecision {
  APPROVED // اعتماد
  CHANGES_REQUESTED // طلب تعديل
  REJECTED // رفض
}

/// مراحل الصفقة السبعة. الصفقة ما تقفلش قبل موافقة الجهاز (المرحلة 6).
enum DealStage {
  INTEREST // 1 اهتمام
  COMMISSION_AGREEMENT // 2 اتفاق العمولة
  PRICE_AGREED // 3 اتفاق السعر
  PRELIMINARY_CONTRACT // 4 العقد المبدئي والعربون
  TRANSFER_FILED // 5 تقديم ملف التنازل للجهاز
  AUTHORITY_APPROVED // 6 موافقة الجهاز
  CLOSED // 7 الإغلاق
}

enum DealStatus {
  ACTIVE
  ON_HOLD
  CANCELLED
  COMPLETED
}

enum DealEventType {
  CREATED
  STAGE_CHANGED
  DOCUMENT_ADDED
  CONTRACT_UPDATED
  DEPOSIT_UPDATED
  ASSIGNMENT_CHANGED
  NOTE
  CANCELLED
}

enum ContractType {
  COMMISSION_AGREEMENT // اتفاق عمولة
  PRELIMINARY_CONTRACT // عقد مبدئي
  DEPOSIT_RECEIPT // محضر عربون
  POWER_OF_ATTORNEY // توكيل (للتقديم والمتابعة بس)
  BUYER_UNDERTAKING // نموذج 6: تعهد المشتري
  CLOSING // نموذج 7: محضر الإغلاق
  CANCELLATION // نموذج 8: محضر الإلغاء
  LISTING_AUTHORIZATION // نموذج 1: تفويض عرض
  RESCUE_SERVICE // نموذج 9: خدمة إنقاذ المهلة
  PARTNER_AGREEMENT // نموذج 10: اتفاقية الشريك
}

enum ContractStatus {
  DRAFT
  PENDING_LAWYER // مستني اعتماد المحامي
  APPROVED
  SENT_FOR_SIGNATURE
  SIGNED
  VOID
  PARTIALLY_SIGNED // CON-04: طرف وقّع والتاني لسه
  VERIFIED // CON-04: النسخة الموقّعة اتحقق منها (مزوّد أو المحامي)
}

enum CommissionStatus {
  PENDING
  INVOICED
  PAID
  WAIVED
}

enum EscrowStatus {
  AWAITING_TRANSFER // مستني التحويل
  HELD // محفوظ عند البنك
  RELEASED_TO_SELLER // اتصرف للبائع
  REFUNDED_TO_BUYER // اترد للمشتري (لو الجهاز رفض)
}

enum RateSource {
  CBE_AUTO // سحب آلي من البنك المركزي
  MANUAL // إدخال يدوي
  MARKET_API // سحب آلي من مصدر سوق مفتوح (احتياطي لو موقع البنك المركزي مش متاح)
}

enum BuyRequestStatus {
  ACTIVE
  PAUSED
  FULFILLED
  CANCELLED
}

enum ServiceType {
  DEADLINE_RESCUE // إنقاذ المهلة
  SITE_INSPECTION // معاينة
  VALUATION // MKT-03: «اعرف قيمة قطعتك»
}

enum ServiceRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
}

// ───────────────────────── الجداول ─────────────────────────

model User {
  uploadSessions     UploadSession[]
  documentRequests   DocumentRequest[]
  id                 String            @id @default(cuid())
  name               String
  phone              String            @unique //بصيغة دولية E.164 زي +201001234567
  email              String?           @unique
  countryOfResidence String?           @db.Char(2) //كود الدولة ISO، مثلاً EG أو SA
  locale             Locale            @default(ar)
  role               Role              @default(CLIENT)
  accountLevel       AccountLevel      @default(BASIC)
  twoFactorEnabled   Boolean           @default(false) //إجباري للفريق
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  //حذف بالطلب (قانون 151): البيانات الشخصية بتتمسح والسجل يفضل
  anonymizedAt       DateTime?
  /// MKT-10: مصدر التسجيل (first/last touch: utm + referrer + كود الإحالة)
  source             Json?
  /// MKT-06: كود الإحالة بتاع المستخدم + مين أحاله
  referralCode       String?           @unique
  referredById       String?
  referredBy         User?             @relation("Referral", fields: [referredById], references: [id])
  referrals          User[]            @relation("Referral")
  rewardsEarned      ReferralReward[]  @relation("RewardReferrer")
  rewardsAsReferred  ReferralReward[]  @relation("RewardReferred")
  /// DEAL-03: قناة كود التحقق الافتراضية (whatsapp | sms | email | totp)
  otpChannel         String            @default("whatsapp")
  actionCodes        ActionCode[]
  consentRecords     ConsentRecord[]
  /// MKT-07: نصيب السمسار الشريك من العمولة (%)
  partnerSharePct    Decimal?          @db.Decimal(5, 2)
  // التحقق الثنائي (تطبيق Authenticator) — السر متشفّر بـ AES-GCM
  totpSecret         String?
  totpEnabledAt      DateTime?
  // موافقة صريحة على الشروط وسياسة الخصوصية (قانون 151)
  termsAcceptedAt    DateTime?
  // PERM-07: إيقاف الحساب
  status             AccountStatus     @default(ACTIVE)
  suspendedAt        DateTime?
  suspendReason      String?
  // PERM-08: بيزيد مع تغيير الدور أو الإيقاف → كل الجلسات القديمة بتتقفل
  sessionVersion     Int               @default(0)
  // PERM-05: السمسار الشريك — رقم القيد بيتراجع من الأدمن قبل التفعيل
  brokerRegNo        String?
  partnerApprovedAt  DateTime?
  // عدد مرات رفض التوثيق (بعد 3 = مراجعة أدمن)
  kycRejections      Int               @default(0)

  notifications          Notification[]
  reconciliations        Reconciliation[]  @relation("ReconciliationBy")
  assignedListingsBroker Listing[]         @relation("ListingBroker")
  assignedListingsLawyer Listing[]         @relation("ListingLawyer")
  submittedListings      Listing[]         @relation("ListingSubmitter")
  paymentRequests        PaymentApproval[] @relation("ApprovalRequester")
  paymentDecisions       PaymentApproval[] @relation("ApprovalDecider")
  kycProfile             KycProfile?       @relation("KycUser")
  kycReviews             KycProfile[]      @relation("KycReviewer")
  listings               Listing[]         @relation("Seller")
  ownedDocuments         Document[]        @relation("DocumentOwner")
  uploadedDocuments      Document[]        @relation("DocumentUploader")
  reviews                Review[]
  dealsAsBuyer           Deal[]            @relation("DealBuyer")
  dealsAsBroker          Deal[]            @relation("DealBroker")
  dealsAsLawyer          Deal[]            @relation("DealLawyer")
  dealsAsAgent           Deal[]            @relation("DealAgent")
  dealEvents             DealEvent[]
  approvedContracts      Contract[]        @relation("ContractApprover")
  verifiedContracts      Contract[]        @relation("ContractVerifier")
  issuedDocuments        IssuedDocument[]
  enteredRates           ExchangeRate[]
  buyRequests            BuyRequest[]
  serviceRequests        ServiceRequest[]  @relation("ServiceRequester")
  assignedServices       ServiceRequest[]  @relation("ServiceAssignee")
  auditLogs              AuditLog[]
  createdPlots           Plot[]

  @@index([role])
  @@index([referredById])
}

/// توثيق الهوية — مراجعة يدوية في المرحلة 1
model KycProfile {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation("KycUser", fields: [userId], references: [id])
  idType           IdType
  idDocumentId     String?            @unique
  idDocument       Document?          @relation("KycIdDocument", fields: [idDocumentId], references: [id])
  selfieDocumentId String?            @unique
  selfieDocument   Document?          @relation("KycSelfie", fields: [selfieDocumentId], references: [id])
  status           VerificationStatus @default(PENDING)
  reviewedById     String?
  reviewedBy       User?              @relation("KycReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
}

/// القطعة: ثابتة بكودها. الكود مخفي عن المشتري لحد اتفاق العمولة (بيتفحص في الخادم).
model Plot {
  // GEO-02: الحي (المكان) والطرح (مرحلة بيت الوطن) منفصلين
  districtId          String?
  districtRef         District?                                    @relation(fields: [districtId], references: [id])
  offeringRoundId     String?
  offeringRound       OfferingRound?                               @relation(fields: [offeringRoundId], references: [id])
  id                  String                                       @id @default(cuid())
  city                String
  cityRef             City                                         @relation(fields: [city], references: [id])
  district            String //المرحلة / الحي
  /// DATA-07: الاسم الإنجليزي للحي (من جدول District)
  districtEn          String?
  code                String //كود القطعة
  areaSqm             Decimal                                      @db.Decimal(10, 2)
  //حدود القطعة (PostGIS). Prisma ما بيقراهاش مباشرة — بنكتب ونقرا بـ SQL.
  boundary            Unsupported("geometry(MultiPolygon, 4326)")?
  paymentStatus       PlotPaymentStatus                            @default(INSTALLMENTS)
  buildDeadline       DateTime?                                    @db.Date //نهاية مهلة البناء
  constructionPercent Int                                          @default(0) //نسبة التنفيذ 0–100
  createdById         String?
  createdBy           User?                                        @relation(fields: [createdById], references: [id])
  createdAt           DateTime                                     @default(now())
  updatedAt           DateTime                                     @updatedAt

  listings        Listing[]
  documents       Document[]
  serviceRequests ServiceRequest[]

  //نفس القطعة ما تتسجلش مرتين — ده أساس كشف العروض المكررة
  @@unique([city, district, code])
  @@index([buildDeadline])
  @@index([districtId])
  @@index([offeringRoundId])
}

/// DATA-07: قايمة الأحياء/المراحل لكل مدينة — الـ wizard بيختار منها بدل النص الحر
model District {
  plots     Plot[]
  id        String   @id @default(cuid())
  city      String
  cityRef   City     @relation(fields: [city], references: [id])
  nameAr    String
  nameEn    String
  sort      Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([city, nameAr])
}

model Listing {
  id                 String        @id @default(cuid())
  plotId             String
  plot               Plot          @relation(fields: [plotId], references: [id])
  sellerId           String
  seller             User          @relation("Seller", fields: [sellerId], references: [id])
  priceType          PriceType
  //شامل: السعر الكلي. مدفوع + أوفر: قيمة الأوفر بس.
  price              Decimal       @db.Decimal(14, 2)
  currency           Currency      @default(EGP)
  //في حالة «مدفوع بالدولار + أوفر»: المبلغ اللي اتدفع للجهاز بالدولار
  paidAmountUsd      Decimal?      @db.Decimal(14, 2)
  status             ListingStatus @default(DRAFT)
  publishedAt        DateTime?
  // PERM-04: الإسناد — الوسيط والمحامي المسؤولين عن العرض
  assignedBrokerId   String?
  assignedBroker     User?         @relation("ListingBroker", fields: [assignedBrokerId], references: [id])
  assignedLawyerId   String?
  assignedLawyer     User?         @relation("ListingLawyer", fields: [assignedLawyerId], references: [id])
  // PERM-05: السمسار الشريك اللي رفع العرض نيابة عن عميله + موافقة العميل
  /// MKT-02: الأقساط الباقية للجهاز بالدولار (المشتري بيكمّلها)
  remainingUsd       Decimal?      @db.Decimal(14, 2)
  /// DATA-03: إفادة الجهاز انتهت والعرض «محتاج تحديث»
  statementExpiredAt DateTime?
  submittedById      String?
  submittedBy        User?         @relation("ListingSubmitter", fields: [submittedById], references: [id])
  clientConsentAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  documents Document[]
  deals     Deal[]

  @@index([status, publishedAt])
  @@index([plotId])
  @@index([sellerId])
  @@index([assignedBrokerId])
}

/// PERM-09: صرف فوق الحد محتاج موافقة أدمن قبل ما يتنفذ
model PaymentApproval {
  id            String         @id @default(cuid())
  depositId     String
  deposit       Deposit        @relation(fields: [depositId], references: [id])
  action        String // RELEASED_TO_SELLER أو REFUNDED_TO_BUYER
  amount        Decimal        @db.Decimal(14, 2)
  status        ApprovalStatus @default(PENDING)
  requestedById String
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  note          String?
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?

  @@index([status, createdAt])
}

/// المستندات: كل إصدار بيتحفظ، ومفيش حذف.
/// الملف نفسه في خزنة S3 المشفرة، وهنا المفتاح بس.
model Document {
  id               String          @id @default(cuid())
  type             DocumentType
  //كل إصدارات نفس المستند ليها نفس groupId
  groupId          String          @default(cuid())
  version          Int             @default(1)
  status           DocumentStatus  @default(UPLOADED)
  ownerId          String
  owner            User            @relation("DocumentOwner", fields: [ownerId], references: [id])
  uploadedById     String
  uploadedBy       User            @relation("DocumentUploader", fields: [uploadedById], references: [id])
  plotId           String?
  plot             Plot?           @relation(fields: [plotId], references: [id])
  listingId        String?
  listing          Listing?        @relation(fields: [listingId], references: [id])
  dealId           String?
  deal             Deal?           @relation(fields: [dealId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  storageKey       String          @unique
  fileName         String
  /// DOC-01: عنوان «مستند آخر» (إجباري للنوع OTHER)
  title            String?
  mimeType         String
  sizeBytes        Int
  sha256           String          @db.Char(64)
  expiresAt        DateTime?       @db.Date //تاريخ انتهاء المستند (لو له)
  /// OPS-02: مكان ووقت تصوير صورة الموقع
  geoLat           Float?
  geoLng           Float?
  geoAccuracyM     Float?
  takenAt          DateTime?
  createdAt        DateTime        @default(now())

  reviews           Review[]
  kycIdFor          KycProfile?       @relation("KycIdDocument")
  kycSelfieFor      KycProfile?       @relation("KycSelfie")
  contractPdfFor    Contract?
  depositReceiptFor Deposit?
  requestsFulfilled DocumentRequest[]

  @@unique([groupId, version])
  @@index([ownerId])
  @@index([listingId])
  @@index([dealId])
  @@index([status, expiresAt])
}

/// مراجعة المحامي — نفس بنود شاشة المحامي
model Review {
  id         String         @id @default(cuid())
  documentId String?
  document   Document?      @relation(fields: [documentId], references: [id])
  contractId String?
  contract   Contract?      @relation(fields: [contractId], references: [id])
  lawyerId   String
  lawyer     User           @relation(fields: [lawyerId], references: [id])
  //بنود المراجعة: [{ key, label, passed, note }]
  checklist  Json
  decision   ReviewDecision
  notes      String?
  createdAt  DateTime       @default(now())

  @@index([documentId])
  @@index([contractId])
  @@index([lawyerId])
}

/// الصفقة: الانتقال بين المراحل له شروط مبرمجة (state machine في الخادم)
model Deal {
  documentRequests   DocumentRequest[]
  issuedDocuments    IssuedDocument[]
  id                 String            @id @default(cuid())
  listingId          String
  listing            Listing           @relation(fields: [listingId], references: [id])
  buyerId            String
  buyer              User              @relation("DealBuyer", fields: [buyerId], references: [id])
  stage              DealStage         @default(INTEREST)
  status             DealStatus        @default(ACTIVE)
  agreedPrice        Decimal?          @db.Decimal(14, 2)
  agreedCurrency     Currency?
  // السعر المقترح من الوسيط — بيتسجل «متفق» بعد ما الطرفين يوافقوا جوه الغرفة
  proposedPrice      Decimal?          @db.Decimal(14, 2)
  buyerPriceOkAt     DateTime?
  sellerPriceOkAt    DateTime?
  // DATA-01: سعر الصرف بيتثبت مرة واحدة لحظة توقيع العقد المبدئي
  rateLockedAt       DateTime?
  //سعر الصرف المثبّت وقت اتفاق السعر (نسخة من القيمة + المرجع)
  lockedUsdEgpRate   Decimal?          @db.Decimal(12, 4)
  exchangeRateId     String?
  exchangeRate       ExchangeRate?     @relation(fields: [exchangeRateId], references: [id])
  // الفريق
  brokerId           String?
  broker             User?             @relation("DealBroker", fields: [brokerId], references: [id])
  lawyerId           String?
  lawyer             User?             @relation("DealLawyer", fields: [lawyerId], references: [id])
  agentId            String?
  agent              User?             @relation("DealAgent", fields: [agentId], references: [id])
  stageChangedAt     DateTime          @default(now())
  closedAt           DateTime?
  /// OPS-02: حالة ملف التنازل في الجهاز (SUBMITTED / NEEDS_INFO / APPROVED / REJECTED)
  authorityStatus    String?
  authorityUpdatedAt DateTime?
  /// DEAL-01: مصدر سعر الصرف المثبّت
  fxSource           String?
  /// MKT-10: مصدر المشتري لما أبدى اهتمام
  source             Json?
  /// DATA-04: صفقة من بيانات التجربة — ما تدخلش في المؤشر ولا العدادات لما DEMO_MODE مقفول
  isDemo             Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  events         DealEvent[]
  contracts      Contract[]
  documents      Document[]
  commission     Commission?
  deposits       Deposit[]
  referralReward ReferralReward?
  story          DealStory?

  @@index([stage, status])
  @@index([status, isDemo])
  @@index([listingId])
  @@index([buyerId])
  @@index([brokerId])
}

/// «سجل الصفقة»
model DealEvent {
  id        String        @id @default(cuid())
  dealId    String
  deal      Deal          @relation(fields: [dealId], references: [id])
  type      DealEventType
  fromStage DealStage?
  toStage   DealStage?
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id])
  data      Json?
  createdAt DateTime      @default(now())

  @@index([dealId, createdAt])
}

model Contract {
  id                    String         @id @default(cuid())
  dealId                String
  deal                  Deal           @relation(fields: [dealId], references: [id])
  type                  ContractType
  templateVersion       String //نسخة النموذج، مثلاً v3
  status                ContractStatus @default(DRAFT)
  //التوقيعات من مزود التوقيع المرخّص: [{ userId, role, signedAt, providerRef }]
  signatures            Json           @default("[]")
  providerEnvelopeId    String?        @unique
  pdfDocumentId         String?        @unique
  pdfDocument           Document?      @relation(fields: [pdfDocumentId], references: [id])
  approvedById          String?
  approvedBy            User?          @relation("ContractApprover", fields: [approvedById], references: [id])
  approvedAt            DateTime?
  signedAt              DateTime?
  // CON-04: التحقق من النسخة الموقّعة (المحامي أو شهادة مزوّد التوقيع) + مكان الأصل الورقي
  verifiedAt            DateTime?
  verifiedById          String?
  verifiedBy            User?          @relation("ContractVerifier", fields: [verifiedById], references: [id])
  verificationMethod    String?
  verificationChecklist Json?
  paperOriginalLocation String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  reviews Review[]

  @@index([dealId, type])
}

/// النسب بتتنسخ في الصفقة وقت إنشائها — تغيير النسبة في الإعدادات بيسري على الجديد بس
model Commission {
  id            String           @id @default(cuid())
  dealId        String           @unique
  deal          Deal             @relation(fields: [dealId], references: [id])
  sellerRatePct Decimal          @db.Decimal(5, 2)
  buyerRatePct  Decimal          @db.Decimal(5, 2)
  sellerAmount  Decimal?         @db.Decimal(14, 2)
  buyerAmount   Decimal?         @db.Decimal(14, 2)
  currency      Currency         @default(EGP)
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  /// OPS-01: مرجع التحصيل (تحويل بنكي/إيصال)
  paymentRef    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

/// العربون: الفلوس نفسها عند البنك، النظام بيتابع الحالة بس
model Deposit {
  id                String            @id @default(cuid())
  dealId            String
  deal              Deal              @relation(fields: [dealId], references: [id])
  amount            Decimal           @db.Decimal(14, 2)
  currency          Currency          @default(EGP)
  receiptDocumentId String?           @unique
  receiptDocument   Document?         @relation(fields: [receiptDocumentId], references: [id])
  approvals         PaymentApproval[]
  escrowStatus      EscrowStatus      @default(AWAITING_TRANSFER)
  bankReference     String?
  /// DEAL-03 بند 7: المشتري أكد «حوّلت العربون» والبائع أكد «استلمت المبلغ» (بكود تحقق)
  buyerSentAt       DateTime?
  sellerReceivedAt  DateTime?
  heldAt            DateTime?
  settledAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([dealId])
}

/// OPS-01: المطابقة الشهرية — إجمالي العرابين المحفوظة في النظام مقابل رقم كشف البنك
model Reconciliation {
  id          String   @id @default(cuid())
  month       String // YYYY-MM
  systemTotal Decimal  @db.Decimal(14, 2)
  bankTotal   Decimal  @db.Decimal(14, 2)
  note        String?
  enteredById String
  enteredBy   User     @relation("ReconciliationBy", fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())

  @@index([month])
}

/// سعر صرف الدولار بالجنيه
model ExchangeRate {
  id          String     @id @default(cuid())
  date        DateTime   @db.Date
  base        Currency   @default(USD)
  quote       Currency   @default(EGP)
  buy         Decimal    @db.Decimal(12, 4)
  sell        Decimal    @db.Decimal(12, 4)
  source      RateSource
  //الإدخال اليدوي بيتسجل باسم اللي دخّله
  enteredById String?
  enteredBy   User?      @relation(fields: [enteredById], references: [id])
  createdAt   DateTime   @default(now())

  deals Deal[]

  @@index([base, quote, date])
}

/// مؤشر الأسعار — من الصفقات المقفولة بس
model PriceIndex {
  id             String   @id @default(cuid())
  city           String
  cityRef        City     @relation(fields: [city], references: [id])
  district       String   @default("") //فاضي = المدينة كلها
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  avgPricePerSqm Decimal  @db.Decimal(14, 2)
  currency       Currency @default(EGP)
  dealCount      Int
  computedAt     DateTime @default(now())

  @@unique([city, district, periodStart])
}

/// طلبات الشراء — للمطابقة الآلية مع العروض
model BuyRequest {
  id             String           @id @default(cuid())
  buyerId        String
  buyer          User             @relation(fields: [buyerId], references: [id])
  cities         String[]
  minAreaSqm     Decimal?         @db.Decimal(10, 2)
  maxAreaSqm     Decimal?         @db.Decimal(10, 2)
  budgetMax      Decimal?         @db.Decimal(14, 2)
  currency       Currency         @default(EGP)
  status         BuyRequestStatus @default(ACTIVE)
  /// MKT-13: موافقة صريحة على تنبيهات واتساب/إيميل + رابط إيقاف + آخر تنبيه (رسالة واحدة في اليوم)
  alertConsentAt DateTime?
  unsubToken     String?          @unique
  lastAlertAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}

/// MKT-04: «فكّرني بمهلتي» — من غير حساب كامل
model DeadlineReminder {
  id             String    @id @default(cuid())
  phone          String
  city           String
  cityRef        City      @relation(fields: [city], references: [id])
  deadline       DateTime  @db.Date
  plotCode       String?
  locale         String    @default("ar")
  consentAt      DateTime
  unsubToken     String    @unique
  unsubscribedAt DateTime?
  sent90At       DateTime?
  sent30At       DateTime?
  sent7At        DateTime?
  source         Json?
  createdAt      DateTime  @default(now())

  @@index([city])
  @@index([deadline])
}

/// رسايل برّه المنصة (واتساب/إيميل) — بتتسجل هنا وبتتبعت لما المزوّد يتظبط
model OutboundMessage {
  id        String    @id @default(cuid())
  channel   String
  to        String
  kind      String
  body      String
  status    String    @default("QUEUED")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
  @@index([to, kind, createdAt])
}

/// MKT-06: مكافأة إحالة — بتستحق بس لما صفقة المُحال تتقفل
model ReferralReward {
  id         String    @id @default(cuid())
  referrerId String
  referrer   User      @relation("RewardReferrer", fields: [referrerId], references: [id])
  referredId String
  referred   User      @relation("RewardReferred", fields: [referredId], references: [id])
  dealId     String    @unique
  deal       Deal      @relation(fields: [dealId], references: [id])
  amount     Decimal   @db.Decimal(14, 2)
  status     String    @default("DUE")
  paidAt     DateTime?
  paymentRef String?
  createdAt  DateTime  @default(now())

  @@index([referrerId])
}

/// MKT-12: مصروف الحملة في الشهر (إدخال يدوي) → تكلفة العميل
model CampaignSpend {
  id          String   @id @default(cuid())
  channel     String
  month       String
  amountEgp   Decimal  @db.Decimal(14, 2)
  enteredById String
  createdAt   DateTime @default(now())

  @@unique([channel, month])
}

/// MKT-14: قصة صفقة حقيقية بموافقة الطرفين — الأدمن بيراجع وينشر
model DealStory {
  id              String    @id @default(cuid())
  dealId          String    @unique
  deal            Deal      @relation(fields: [dealId], references: [id])
  buyerConsentAt  DateTime?
  sellerConsentAt DateTime?
  showPlotCode    Boolean   @default(false)
  buyerShowCode   Boolean   @default(false)
  sellerShowCode  Boolean   @default(false)
  textAr          String?
  textEn          String?
  status          String    @default("PENDING")
  reviewedById    String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
}

/// أول جدول هيشتغل: فورم صفحة «إنقاذ المهلة».
/// الطلب ممكن يوصل قبل ما يبقى فيه حساب أو قطعة مسجلة، فبيانات التواصل والقطعة نص حر.
model ServiceRequest {
  id                   String               @id @default(cuid())
  type                 ServiceType
  status               ServiceRequestStatus @default(NEW)
  contactName          String
  contactPhone         String
  requesterId          String?
  requester            User?                @relation("ServiceRequester", fields: [requesterId], references: [id])
  plotId               String?
  plot                 Plot?                @relation(fields: [plotId], references: [id])
  city                 String?
  cityRef              City?                @relation(fields: [city], references: [id], onDelete: Restrict)
  district             String?
  plotCode             String?
  message              String?
  fee                  Decimal?             @db.Decimal(14, 2)
  feeCurrency          Currency?
  /// OPS-02: تقدير المندوب لنسبة التنفيذ من المعاينة
  constructionEstimate Int?
  /// MKT-10: مصدر الطلب
  source               Json?
  assignedToId         String?
  assignedTo           User?                @relation("ServiceAssignee", fields: [assignedToId], references: [id])
  documents            Document[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, createdAt])
}

/// سجل التدقيق: مين، عمل إيه، على إيه، امتى، منين. ما يتعدلش وما يتمسحش.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String //مثلاً document.view أو deal.stage_change
  entityType String
  entityId   String
  ip         String?
  userAgent  String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

/// الإشعارات: بتظهر جوه المنصة دايماً، وبتتبعت واتساب/إيميل لما المزوّد يتظبط
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  kind      String // مثلاً contract.sign_needed أو deposit.held
  title     String
  body      String?
  link      String?
  sentVia   String? // whatsapp أو email لو اتبعتت برّه المنصة
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// رموز الدخول على واتساب. الرمز نفسه مش بيتخزن — بصمته (sha256) بس.
model LoginCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String    @db.Char(64)
  purpose   String    @default("sign_in") // sign_in أو sign_up
  attempts  Int       @default(0)
  ip        String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

/// مخزن ملفات احتياطي: بيتستخدم لما S3 مش متظبط (التطوير والنسخة التجريبية).
/// على الإنتاج الملفات بتروح خزنة S3 المشفرة، والجدول ده يفضل فاضي.
model FileBlob {
  key       String   @id
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

/// إعدادات المنصة اللي بتتغير من شاشة الإعدادات (نسب العمولة، رسوم الخدمات، نماذج العقود)
/// كل تغيير بيتسجل في سجل التدقيق.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// DEAL-03: كود تحقق مربوط بإجراء واحد (المستخدم + الإجراء + الصفقة + القيم) — 6 أرقام، 5 دقايق، مرة واحدة
model ActionCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  action     String
  dealId     String?
  paramsHash String
  summary    String
  codeHash   String
  channel    String
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId, action, createdAt])
  @@index([userId, createdAt])
}

/// DEAL-03: بعد 5 محاولات غلط الإجراء بيتقفل 15 دقيقة
model ActionLock {
  id          String   @id @default(cuid())
  userId      String
  action      String
  lockedUntil DateTime

  @@unique([userId, action])
}

/// CON-03 + DEAL-03: سجل الموافقات — إضافة بس (trigger في قاعدة البيانات بيمنع التعديل والحذف)
model ConsentRecord {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  kind              String
  action            String?
  templateVersionId String?
  dealId            String?
  listingId         String?
  summary           String
  renderedText      String?
  sha256            String
  channel           String
  phoneLast4        String?
  acceptedAt        DateTime  @default(now())
  otpVerifiedAt     DateTime?
  ip                String?
  userAgent         String?

  @@index([userId, acceptedAt])
  @@index([dealId])
}

/// TXN-01 / CON-06: سجل مرقّم لكل PDF بيطلع من المنصة — صفحة التحقق (QR) بتقرا منه. إضافة بس (append-only).
model IssuedDocument {
  id              String   @id @default(cuid())
  seq             Int      @unique @default(autoincrement())
  code            String   @unique
  kind            String // STATEMENT | CONTRACT_DRAFT | EXPORT
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id])
  contractId      String?
  templateVersion String?
  issuedToId      String?
  issuedTo        User?    @relation(fields: [issuedToId], references: [id])
  copyFor         String? // BUYER | SELLER | STAFF
  sha256          String
  pages           Int
  createdAt       DateTime @default(now())

  @@index([dealId])
  @@index([contractId])
}

/// GEO-01: المدن جدول (الأدمن بيضيف/يعدّل/يوقف — ممنوع الحذف لو عليها قطع). الـ id نص ثابت (NEW_CAIRO…)
model City {
  id              String   @id
  nameAr          String
  nameEn          String
  slug            String   @unique
  codePrefix      String   @unique
  /// GEO-04: مثلاً {prefix}-{block}-{number}
  plotCodePattern String   @default("{prefix}-{block}-{number}")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  plots           Plot[]
  districts       District[]
  priceIndex      PriceIndex[]
  reminders       DeadlineReminder[]
  serviceRequests ServiceRequest[]
  rounds          OfferingRound[]

  @@map("Cities")
}

/// GEO-02: الطرح (رقمه، سنته، شروطه، مهلة البناء الافتراضية)
model OfferingRound {
  id                         String   @id @default(cuid())
  cityId                     String?
  city                       City?    @relation(fields: [cityId], references: [id])
  nameAr                     String
  nameEn                     String
  number                     Int
  year                       Int?
  terms                      String?
  defaultBuildDeadlineMonths Int?
  installmentCurrency        String   @default("USD")
  isActive                   Boolean  @default(true)
  createdAt                  DateTime @default(now())

  plots Plot[]

  @@index([cityId])
}

/// DOC-01: رفع ملف كبير (لحد 20MB) على أجزاء — كل جزء أقل من حد الطلب في Vercel
model UploadSession {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  sizeBytes  Int
  chunkCount Int
  documentId String?
  createdAt  DateTime      @default(now())
  chunks     UploadChunk[]

  @@index([userId, createdAt])
}

model UploadChunk {
  sessionId String
  session   UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  idx       Int
  data      Bytes

  @@id([sessionId, idx])
}

/// DOC-01: المحامي «اطلب مستند» → مهمة للطرف «مطلوب منك رفع: …»
model DocumentRequest {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id])
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  side          String // BUYER | SELLER
  title         String
  note          String?
  status        String    @default("OPEN") // OPEN | FULFILLED | CANCELLED
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id])
  createdAt     DateTime  @default(now())
  fulfilledAt   DateTime?

  @@index([dealId, status])
}
